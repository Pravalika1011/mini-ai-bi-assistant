# Google Gemini API Key (optional - system operates 100% offline via deterministic engine when absent)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (defaults to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Currency Symbol (CSV contains no currency field; defaults to ₹)
CURRENCY_SYMBOL=₹
